# ─────────────────────────────────────────────────────────────────
# Deprecio — пример конфигурации через переменные окружения
# Скопируйте этот файл в .env и заполните значения локально.
# Никогда не коммитьте .env в git.
# ─────────────────────────────────────────────────────────────────

# ── Telegram-бот ────────────────────────────────────────────────
# Обязательно. Токен от @BotFather.
DEPRECIO_BOT_TOKEN=""

# Опционально. Telegram ID администратора для служебных сообщений.
ADMIN_ID=""

# ── Внешние источники данных ─────────────────────────────────────
# Максимальное количество страниц при поиске на Авито (1–20).
AVITO_MAX_PAGES=3

# Время жизни снапшота цен Авито в часах (после — перечитывается).
SNAPSHOT_TTL_HOURS=24

# Таймаут HTTP-запроса к GSMArena (секунды).
GSMARENA_TIMEOUT=10.0

# Таймаут HTTP-запроса к Авито (секунды).
AVITO_TIMEOUT=15.0

# Таймаут HTTP-запроса к сервису цен (секунды).
PRICE_LOOKUP_TIMEOUT=8.0

# Лимит запросов в минуту к Авито (0 = без ограничений).
AVITO_RATE_LIMIT_RPM=30

# Лимит запросов в минуту к GSMArena (0 = без ограничений).
GSMARENA_RATE_LIMIT_RPM=20

# Количество попыток при временных сетевых ошибках (0–5).
EXTERNAL_RETRY_ATTEMPTS=2

# Задержка между повторными попытками (секунды).
EXTERNAL_RETRY_DELAY=1.0

# ── Кэш и файловая система ───────────────────────────────────────
# Директория дискового кэша распарсенных устройств.
CACHE_DIR=.cache/devices

# Директория снапшотов объявлений с Авито.
SNAPSHOT_DIR=.cache/snapshots

# Путь к файлу основного каталога устройств.
CATALOG_FILE=data/catalog.json

# Путь к глобальной базе SQLite (GSMArena, 10 600+ моделей).
GLOBAL_DB_FILE=data/global_devices.db

# ── Логирование ──────────────────────────────────────────────────
# Уровень логирования: DEBUG / INFO / WARNING / ERROR / CRITICAL.
LOG_LEVEL=INFO

# Формат логов: plain (читаемый) / json (для log-агрегаторов).
LOG_FORMAT=plain

# Путь к файлу лога (ротация при 10 МБ, 5 резервных копий).
# Если пусто — логи только в stdout.
LOG_FILE=

# Интервал проверки подписок на цену (секунды).
PRICE_ALERT_CHECK_INTERVAL_SEC=3600

# Максимальное время одной CLI-проверки алертов (секунды).
DEPRECIO_ALERT_CHECK_TIMEOUT_SEC=60

# Максимум активных подписок на пользователя.
PRICE_ALERT_MAX_PER_USER=20

# ── Production operations ─────────────────────────────────────────
# Local SQLite backup directory and retention count.
DEPRECIO_BACKUP_KEEP=5
DEPRECIO_BACKUP_INTERVAL_SEC=3600
# External API requests per IP in a rolling minute.
DEPRECIO_RATE_LIMIT=60
